{{- if eq .chezmoi.os "linux" }}
# SauceCodePro Nerd Font Mono. On macOS the Homebrew cask installs it.
[".local/share/fonts/SauceCodeProNerdFont"]
    type = "archive"
    url = "https://github.com/ryanoasis/nerd-fonts/releases/latest/download/SourceCodePro.tar.xz"
    exact = true
    refreshPeriod = "720h"
    include = ["*NerdFontMono-*.ttf"]
{{- end }}
{{- if .ai }}
{{- /* Agent skills: name, GitHub repo, skill folder in the repo. Each entry
       gets the folder from the default branch, and refreshes it weekly. */}}
{{- range list
      (list "ast-grep" "ast-grep/agent-skill" "ast-grep/skills/ast-grep")
      (list "ast-grep-outline" "ast-grep/agent-skill" "ast-grep/skills/outline")
      (list "caveman" "JuliusBrussee/caveman" "skills/caveman")
      (list "last30days" "mvanhorn/last30days-skill" "skills/last30days")
      (list "security-audit" "cloudflare/security-audit-skill" "skills/security-audit")
      (list "simple-english" "AminBlg/SimpleEnglish" "skills/simple-english") }}

[{{ printf ".agents/skills/%s" (index . 0) | quote }}]
    type = "archive"
    url = "https://github.com/{{ index . 1 }}/archive/HEAD.tar.gz"
    exact = true
    refreshPeriod = "168h"
    stripComponents = {{ add 1 (len (splitList "/" (index . 2))) }}
    include = [{{ printf "*/%s/**" (index . 2) | quote }}]
{{- end }}
{{- end }}
