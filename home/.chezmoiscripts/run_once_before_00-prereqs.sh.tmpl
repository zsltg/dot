#!/bin/bash
# Install the system packages that Homebrew needs, then install Homebrew.
set -euo pipefail
{{ template "brew-env" . }}

{{ if eq .chezmoi.os "linux" -}}
sudo apt-get update
sudo apt-get install -y build-essential procps curl file git zsh unzip fontconfig
{{- else if eq .chezmoi.os "darwin" -}}
if ! xcode-select -p >/dev/null 2>&1; then
  xcode-select --install
  echo "Install the Xcode Command Line Tools, then run 'chezmoi apply' again." >&2
  exit 1
fi
{{- end }}

if [ ! -x "$BREW" ]; then
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
fi
