{{- $p := index .palettes .theme -}}
-- solarized-osaka. With nvim_colors in the selected palette, it uses the colors
-- of that palette (see .chezmoidata/palette.yaml).
return {
    "craftzdog/solarized-osaka.nvim",
    lazy = false,
    priority = 1000,
    opts = {},
    config = function()
        require("solarized-osaka").setup({
{{- if $p.nvim_colors }}
            on_colors = function(c)
                -- Base colors. osaka calculates the float, popup, sidebar and
                -- status line colors before this function, so set them here too.
                c.base04, c.bg = "{{ $p.colors.bg_0 }}", "{{ $p.colors.bg_0 }}"
                c.bg_float, c.bg_popup, c.bg_sidebar = c.bg, c.bg, c.bg
                c.base03, c.bg_highlight, c.bg_statusline = "{{ $p.colors.bg_1 }}", "{{ $p.colors.bg_1 }}", "{{ $p.colors.bg_1 }}"
                c.base02, c.border = "{{ $p.colors.bg_2 }}", "{{ $p.colors.bg_2 }}"
                c.base01, c.base00 = "{{ $p.colors.dim_0 }}", "{{ $p.colors.dim_1 }}"
                c.base0, c.fg, c.fg_float = "{{ $p.colors.fg_0 }}", "{{ $p.colors.fg_0 }}", "{{ $p.colors.fg_0 }}"
                c.base1 = "{{ $p.colors.fg_1 }}"
                -- Accents. The groups use the plain name and the 500 shade.
{{- range list "red" "green" "yellow" "blue" "magenta" "cyan" "orange" "violet" }}
                c.{{ . }}, c.{{ . }}500 = "{{ index $p.colors . }}", "{{ index $p.colors . }}"
{{- end }}
                c.error, c.warning, c.info, c.hint, c.todo = c.red, c.yellow, c.blue, c.cyan, c.violet
            end,
{{- end }}
            on_highlights = function(hl, c)
                -- Default
                hl.NormalFloat = {
                    bg = c.base02,
                }
                hl.LineNr = {
                    fg = c.base01,
                }
                -- which-key: same background as the status line
                hl.WhichKeyNormal = {
                    fg = c.base0,
                    bg = c.bg_statusline,
                }
                hl.WhichKeyBorder = {
                    fg = c.base02,
                    bg = c.bg_statusline,
                }
                hl.WhichKeyTitle = {
                    fg = c.base1,
                    bg = c.bg_statusline,
                }
                -- fzf-lua: no background, as Normal
                hl.FzfLuaNormal = { fg = c.base0 }
                hl.FzfLuaBorder = { fg = c.base02 }
                hl.FzfLuaTitle = { fg = c.orange }
                hl.FzfLuaPreviewTitle = { fg = c.blue }
                hl.FzfLuaHeaderBind = { fg = c.yellow }
                -- blink.cmp
                hl.BlinkCmpSignatureHelpActiveParameter = {
                    fg = c.base2,
                    bold = true,
                }
            end,
        })
        vim.cmd("colorscheme solarized-osaka")
    end,
}
