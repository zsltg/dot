set -g history-limit 10000
set -g mouse on
set -g repeat-time 0
set -g extended-keys on
set -ag terminal-overrides ",*:RGB"

# F11 and F12 go to the previous and next window.
bind-key -n F11 select-window -p
bind-key -n F12 select-window -n
# Shift+Del sends Ctrl-X (the delete key of the fzf history widget).
bind-key -n S-DC send-keys C-x

# Selenized with the Solarized background (see .chezmoidata/palette.yaml).
# black is bg_1, white is dim_0. orange has no terminal slot, so it is a hex value.
set -g status-style fg=yellow,bg=black
setw -g window-status-style fg=default,bg=default
setw -g window-status-current-style "fg={{ .palette.orange }},bg=default"
set -g pane-border-style fg=black
set -g pane-active-border-style fg=white
set -g message-style "fg={{ .palette.orange }},bg=black"
set -g display-panes-active-colour "{{ .palette.orange }}"
set -g display-panes-colour blue
setw -g clock-mode-colour green
setw -g window-status-bell-style fg=black,bg=red
