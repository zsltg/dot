set -g history-limit 10000
set -g mouse on
set -g repeat-time 0
# With extended-keys on, tmux 3.5 and later ask the outer terminal for extended
# keys. herdr then sends kitty key events, also key release events, and typed
# text becomes garbled (for example "h4;1:3u" for "h"). Keep it off.
set -g extended-keys off
set -ag terminal-overrides ",*:RGB"

# F11 and F12 go to the previous and next window.
bind-key -n F11 select-window -p
bind-key -n F12 select-window -n
# Shift+Del sends Ctrl-X (the delete key of the fzf history widget).
bind-key -n S-DC send-keys C-x

{{ $c := (index .palettes .theme).colors -}}
# Colors of the selected palette (see .chezmoidata/palette.yaml).
set -g status-style "fg={{ $c.yellow }},bg={{ $c.bg_1 }}"
setw -g window-status-style "fg={{ $c.fg_0 }},bg=default"
setw -g window-status-current-style "fg={{ $c.orange }},bg=default"
set -g pane-border-style "fg={{ $c.bg_1 }}"
set -g pane-active-border-style "fg={{ $c.dim_0 }}"
set -g message-style "fg={{ $c.orange }},bg={{ $c.bg_1 }}"
set -g display-panes-active-colour "{{ $c.orange }}"
set -g display-panes-colour "{{ $c.blue }}"
setw -g clock-mode-colour "{{ $c.green }}"
setw -g window-status-bell-style "fg={{ $c.bg_1 }},bg={{ $c.red }}"
