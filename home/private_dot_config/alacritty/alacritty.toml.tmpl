{{- $p := index .palettes .theme -}}
[env]
  TERM = "xterm-256color"

[font]
normal = { family = "SauceCodePro Nerd Font Mono", style = "Regular" }
size = 12

# Colors of the selected palette (see .chezmoidata/palette.yaml).
[colors.primary]
background = "0x{{ $p.colors.bg_0 | trimPrefix "#" }}"
foreground = "0x{{ $p.colors.fg_0 | trimPrefix "#" }}"

[colors.normal]
black   = "0x{{ index $p.colors (index $p.ansi 0) | trimPrefix "#" }}"
red     = "0x{{ index $p.colors (index $p.ansi 1) | trimPrefix "#" }}"
green   = "0x{{ index $p.colors (index $p.ansi 2) | trimPrefix "#" }}"
yellow  = "0x{{ index $p.colors (index $p.ansi 3) | trimPrefix "#" }}"
blue    = "0x{{ index $p.colors (index $p.ansi 4) | trimPrefix "#" }}"
magenta = "0x{{ index $p.colors (index $p.ansi 5) | trimPrefix "#" }}"
cyan    = "0x{{ index $p.colors (index $p.ansi 6) | trimPrefix "#" }}"
white   = "0x{{ index $p.colors (index $p.ansi 7) | trimPrefix "#" }}"

[colors.bright]
black   = "0x{{ index $p.colors (index $p.ansi 8) | trimPrefix "#" }}"
red     = "0x{{ index $p.colors (index $p.ansi 9) | trimPrefix "#" }}"
green   = "0x{{ index $p.colors (index $p.ansi 10) | trimPrefix "#" }}"
yellow  = "0x{{ index $p.colors (index $p.ansi 11) | trimPrefix "#" }}"
blue    = "0x{{ index $p.colors (index $p.ansi 12) | trimPrefix "#" }}"
magenta = "0x{{ index $p.colors (index $p.ansi 13) | trimPrefix "#" }}"
cyan    = "0x{{ index $p.colors (index $p.ansi 14) | trimPrefix "#" }}"
white   = "0x{{ index $p.colors (index $p.ansi 15) | trimPrefix "#" }}"

[keyboard]
bindings = [
  { key = "Right",  mods = "Alt",             chars = "\u001BF" },
  { key = "Left",   mods = "Alt",             chars = "\u001BB" },
  { key = "F",      mods = "Command|Control", action = "ToggleFullscreen" },
  { key = "Equals", mods = "Control",         action = "IncreaseFontSize" },
  { key = "Minus",  mods = "Control",         action = "DecreaseFontSize" },
]
{{- if eq .chezmoi.os "darwin" }}

[window]
# Use the Option key as Alt (for Alt-Left, Alt-Right, Alt-C).
option_as_alt = "Both"
{{- else }}

[bell]
command = { program = "pw-play", args = ["/usr/share/sounds/freedesktop/stereo/message.oga"] }
{{- end }}
