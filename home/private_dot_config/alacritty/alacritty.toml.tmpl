[env]
  TERM = "xterm-256color"

[font]
normal = { family = "SauceCodePro Nerd Font Mono", style = "Regular" }
size = 12

# Selenized with the Solarized background (see .chezmoidata/palette.yaml).
[colors.primary]
background = "0x{{ .palette.bg_0 | trimPrefix "#" }}"
foreground = "0x{{ .palette.fg_0 | trimPrefix "#" }}"

[colors.normal]
black   = "0x{{ .palette.bg_1 | trimPrefix "#" }}"
red     = "0x{{ .palette.red | trimPrefix "#" }}"
green   = "0x{{ .palette.green | trimPrefix "#" }}"
yellow  = "0x{{ .palette.yellow | trimPrefix "#" }}"
blue    = "0x{{ .palette.blue | trimPrefix "#" }}"
magenta = "0x{{ .palette.magenta | trimPrefix "#" }}"
cyan    = "0x{{ .palette.cyan | trimPrefix "#" }}"
white   = "0x{{ .palette.dim_0 | trimPrefix "#" }}"

[colors.bright]
black   = "0x{{ .palette.bg_2 | trimPrefix "#" }}"
red     = "0x{{ .palette.br_red | trimPrefix "#" }}"
green   = "0x{{ .palette.br_green | trimPrefix "#" }}"
yellow  = "0x{{ .palette.br_yellow | trimPrefix "#" }}"
blue    = "0x{{ .palette.br_blue | trimPrefix "#" }}"
magenta = "0x{{ .palette.br_magenta | trimPrefix "#" }}"
cyan    = "0x{{ .palette.br_cyan | trimPrefix "#" }}"
white   = "0x{{ .palette.fg_1 | trimPrefix "#" }}"

[keyboard]
bindings = [
  { key = "Right",  mods = "Alt",             chars = "\u001BF" },
  { key = "Left",   mods = "Alt",             chars = "\u001BB" },
  { key = "F",      mods = "Command|Control", action = "ToggleFullscreen" },
  { key = "Equals", mods = "Control",         action = "IncreaseFontSize" },
  { key = "Minus",  mods = "Control",         action = "DecreaseFontSize" },
]
{{- if eq .chezmoi.os "darwin" }}

[window]
# Use the Option key as Alt (for Alt-Left, Alt-Right, Alt-C).
option_as_alt = "Both"
{{- else }}

[bell]
command = { program = "pw-play", args = ["/usr/share/sounds/freedesktop/stereo/message.oga"] }
{{- end }}
